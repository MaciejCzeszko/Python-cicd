# PostgreSQL credentials for local development
# Used by docker-compose.yml and, if running the app without Docker, by app/database.py and alembic/env.py

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=your_db_name_here

# Connection string for the app and Alembic (adjust host as needed)
DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/your_db_name_here
